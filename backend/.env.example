# TrendFlow AI backend environment
# Copy to .env and fill in. NEVER commit real keys.

# --- LLM (any OpenAI-compatible endpoint) ---
# Leave OPENAI_API_KEY empty to use the offline extractive composer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: real news API for live trends (future work; local demo dataset is default)
# NEWS_API_KEY=

# Swytchcode (optional; CLI works in --demo mode without a token)
# SWYTCHCODE_TOKEN=
